{
  "app": "nextcue",
  "display_name": "Next Cue",
  "target": "iphone_69",
  "copy_contract": "single-header-benefit-story-v3",
  "market": {
    "category": "ADHD routine starters",
    "audience": "Adults who know what their routine is but get stuck starting it, including people looking for ADHD-friendly structure",
    "problem": "Checklists and planners list what to do, but a step that feels too big still leaves the person frozen before it.",
    "advantage": "Next Cue shrinks any step to a tiny first move when the user taps I'm stuck, then brings the whole step back once they start. Templates ship with these smallest starts filled in. The first routine is free; Pro adds more routines.",
    "competitive_context": "Routine apps range from full-day visual planners to timer-led habit trackers. Next Cue focuses on the moment of starting: one current step, a smaller version of it on demand, and no streaks or countdowns.",
    "search_intent": [
      "ADHD routine app",
      "task initiation",
      "procrastination help",
      "step by step routine",
      "morning routine planner",
      "executive function planner"
    ],
    "proof_points": [
      {
        "claim": "The Today screen leads with the first step of the next routine and an even smaller way in.",
        "source": "raw/01-home.png"
      },
      {
        "claim": "Tapping I'm stuck replaces the step with its smallest start and an I started button.",
        "source": "raw/02-stuck.png"
      },
      {
        "claim": "The run screen shows one current step with an I'm stuck button and a count-up timer.",
        "source": "raw/03-run.png"
      },
      {
        "claim": "The editor gives every step an optional smallest start, filled in by the template.",
        "source": "raw/04-editor.png"
      },
      {
        "claim": "The paused run keeps the current step available with a clear resume action.",
        "source": "raw/05-paused.png"
      },
      {
        "claim": "The completion screen confirms the finished routine without a streak count.",
        "source": "raw/06-complete.png"
      }
    ]
  },
